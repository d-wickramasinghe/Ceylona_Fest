rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOrganizer() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isOrganizer == true;
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.isOrganizer == false
        && request.resource.data.role == 'seeker';
      allow update: if signedIn()
        && request.auth.uid == userId
        && (
          (request.resource.data.get('isOrganizer', false) == resource.data.get('isOrganizer', false)
            && request.resource.data.get('role', 'seeker') == resource.data.get('role', 'seeker'))
          || (resource.data.get('isOrganizer', false) != true
            && request.resource.data.get('isOrganizer', false) == true
            && request.resource.data.get('role', '') == 'organizer'
            && request.resource.data.get('organizationName', '') is string)
        );

      match /saved/{eventId} {
        allow read, write: if signedIn() && (request.auth.uid == userId || isAdmin());
      }

      match /notifications/{notificationId} {
        allow read, update: if signedIn() && (request.auth.uid == userId || isAdmin());
        allow create: if isAdmin();
        allow delete: if signedIn() && request.auth.uid == userId;
      }
    }

    match /admins/{adminId} {
      allow read: if signedIn() && request.auth.uid == adminId;
      allow write: if false;

      match /notifications/{notificationId} {
        allow read, update: if signedIn() && request.auth.uid == adminId;
        allow create, delete: if false;
      }
    }

    match /review_checklist_items/{itemId} {
      allow read, write: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if signedIn()
        && (resource.data.status == 'approved'
          || resource.data.organizerId == request.auth.uid
          || isAdmin());
      allow create: if isOrganizer()
        && request.resource.data.organizerId == request.auth.uid
        && request.resource.data.status in ['draft', 'pending'];
      allow update: if isAdmin()
        || (isOrganizer()
          && resource.data.organizerId == request.auth.uid
          && request.resource.data.organizerId == request.auth.uid
          && request.resource.data.status in ['draft', 'pending', 'changes_requested']);
      allow delete: if isAdmin()
        || (signedIn() && resource.data.organizerId == request.auth.uid);

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
        allow delete: if signedIn()
          && (resource.data.userId == request.auth.uid || isAdmin());
      }

      match /decision_log/{logId} {
        allow read, create: if isAdmin();
      }
    }
  }
}
